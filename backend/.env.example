# Nothing here is required to run the app -- every value has a sensible default
# in app/config.py, and the whole stack runs on free, local models.

# Override only if Ollama runs somewhere other than localhost (e.g. its own
# container in docker-compose, where the hostname is the service name "ollama").
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app
